{
  "expo": {
    "name": "Cuevo",
    "slug": "cuevo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/cuevo-app-icon-orange-v3.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-video",
      "expo-sqlite",
      "expo-notifications",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.699911618982-o9n9v5s8t8ebcsuqi3s24du0hjgea6t8"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.cuevo.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cuevo.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF4D24",
        "foregroundImage": "./assets/brand/cuevo-app-icon-orange-v3.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "cuevo",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "95ebb846-bc8b-40ff-b27c-0fb92dcafe0e"
      }
    },
    "owner": "zerojsxs-team"
  }
}
