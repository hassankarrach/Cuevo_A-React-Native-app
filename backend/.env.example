# Required API database (development only).
DATABASE_URL=postgresql+psycopg://cuevo:cuevo_dev_password@localhost:5432/cuevo_dev

# Optional in development; required for the isolated test setup.
TEST_DATABASE_URL=postgresql+psycopg://cuevo:cuevo_dev_password@localhost:5432/cuevo_test

ENVIRONMENT=development
AUTH_SECRET_KEY=replace-with-a-random-32-byte-or-longer-key
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_FROM_ADDRESS=no-reply@cuevo.local

# Public OAuth client IDs for native Google Sign-In; no Web Client Secret is used.
GOOGLE_IOS_CLIENT_ID=699911618982-o9n9v5s8t8ebcsuqi3s24du0hjgea6t8.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=699911618982-tbvbceq7c04nsgnh656ifabrdt3ep7iq.apps.googleusercontent.com

# Local development/test burst limits only; production always uses the fixed
# policy documented in docs/auth-lifecycle.md.
AUTH_RATE_LIMIT_REGISTER_IP_HOUR=100
AUTH_RATE_LIMIT_LOGIN_EMAIL_15M=100
AUTH_RATE_LIMIT_LOGIN_IP_15M=100
AUTH_RATE_LIMIT_VERIFY_EMAIL_15M=100
AUTH_RATE_LIMIT_VERIFY_IP_15M=100
AUTH_RATE_LIMIT_RESEND_EMAIL_30S=5
AUTH_RATE_LIMIT_RESEND_EMAIL_HOUR=100
AUTH_RATE_LIMIT_REFRESH_TOKEN_15M=100
AUTH_RATE_LIMIT_REFRESH_IP_15M=100
AUTH_RATE_LIMIT_RESET_REQUEST_EMAIL_30S=5
AUTH_RATE_LIMIT_RESET_REQUEST_EMAIL_HOUR=100
AUTH_RATE_LIMIT_RESET_REQUEST_IP_HOUR=100
AUTH_RATE_LIMIT_RESET_CONFIRM_EMAIL_HOUR=100
AUTH_RATE_LIMIT_RESET_CONFIRM_IP_HOUR=100
AUTH_RATE_LIMIT_PASSWORD_CHANGE_ACCOUNT_15M=100
AUTH_RATE_LIMIT_PASSWORD_CHANGE_IP_15M=100
AUTH_RATE_LIMIT_GOOGLE_SIGNIN_IP_15M=100
AUTH_RATE_LIMIT_GOOGLE_LINK_ACCOUNT_15M=100
AUTH_RATE_LIMIT_GOOGLE_LINK_IP_15M=100
AUTH_RATE_LIMIT_GOOGLE_UNLINK_ACCOUNT_15M=100
AUTH_RATE_LIMIT_GOOGLE_UNLINK_IP_15M=100
